{
  "_comment": "Rules consumed by periodica.get — all data-driven, no hardcoded chemistry. Edit this file to extend the system to new tiers or property arithmetic without touching code.",
  "version": 2,

  "_tier_comment": "Every folder under data/active/ is a curated tier. Tiers whose name matches a data/derived/<name>/ folder merge into one registry tier; within a merged tier the curated filename stem outranks a derived Symbol, so hand-written sheets win by name while derived entries stay reachable by symbol.",
  "tier_definitions": [
    { "name": "fundamentals",          "source": "active/quarks",               "is_active": true },
    { "name": "antiquarks",            "source": "active/antiquarks",           "is_active": true },
    { "name": "subatomic",             "source": "active/subatomic",            "is_active": true },
    { "name": "elements",              "source": "active/elements",             "is_active": true },
    { "name": "molecules",             "source": "active/molecules",            "is_active": true },
    { "name": "alloys",                "source": "active/alloys",               "is_active": true },
    { "name": "materials",             "source": "active/materials",            "is_active": true },
    { "name": "amino_acids",           "source": "active/amino_acids",          "is_active": true },
    { "name": "proteins",              "source": "active/proteins",             "is_active": true },
    { "name": "nucleic_acids",         "source": "active/nucleic_acids",        "is_active": true },
    { "name": "cells",                 "source": "active/cells",                "is_active": true },
    { "name": "cell_components",       "source": "active/cell_components",      "is_active": true },
    { "name": "biological_materials",  "source": "active/biological_materials", "is_active": true },
    { "name": "tissues",               "source": "active/tissues",              "is_active": true }
  ],

  "derived_root": "derived",

  "additive_properties": [
    "Charge_e",
    "Mass_MeVc2",
    "Mass_kg",
    "Mass_amu",
    "BaryonNumber_B",
    "LeptonNumber_L"
  ],

  "placeholder_prefixes": ["demo_", "example_"]
}
