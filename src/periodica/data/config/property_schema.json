{
  "_comment": [
    "Canonical property vocabulary for periodica. Consumed by periodica.properties.",
    "Nothing here is chemistry: it is a naming + unit dictionary that lets one",
    "physical quantity be written many ways across curated JSON (Density_g_cm3,",
    "density, Density_kgm3, physical_properties.density_g_cm3) and still resolve",
    "to one canonical name in one SI unit.",
    "",
    "How a raw key is read:",
    "  1. the longest matching suffix in `units` is stripped off  -> the unit",
    "  2. the remaining stem is slugified (CamelCase/snake -> snake, alnum only)",
    "  3. the slug is looked up in each property's `aliases`      -> the canonical",
    "  4. a key with no unit suffix uses the alias's `unit`, else the property's",
    "     `default_unit`, else the property's `si_unit`",
    "",
    "`group` only drives presentation order in data sheets and the app."
  ],
  "version": 1,

  "property_group_keys": [
    "Properties", "properties",
    "PhysicalProperties", "physical_properties",
    "MechanicalProperties", "mechanical_properties",
    "ElasticProperties", "elastic_properties",
    "StrengthProperties", "strength_properties",
    "ThermalProperties", "thermal_properties",
    "ElectricalProperties", "electrical_properties",
    "OpticalProperties", "optical_properties",
    "MagneticProperties", "magnetic_properties",
    "ChemicalProperties", "chemical_properties",
    "AcousticProperties", "acoustic_properties",
    "NuclearProperties", "nuclear_properties",
    "LatticeProperties", "lattice_properties",
    "Hardness", "hardness",
    "Ductility", "ductility",
    "FractureMechanics", "fracture_mechanics",
    "FatigueProperties", "fatigue_properties",
    "DerivedProperties", "derived_properties",
    "BiologicalProperties", "biological_properties",
    "TransportProperties", "transport_properties"
  ],

  "excluded_group_keys": [
    "_derivation", "Constituents", "Composition", "Components", "Field",
    "SimulationParameters", "ValidationData", "ProcessingMethods",
    "TemperatureDependencies", "PressureDependencies", "SpatialFields",
    "Microstructure", "PhaseComposition", "Discovery", "Antiparticle"
  ],

